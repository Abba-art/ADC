generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"  
}

// Enums (fonctionnent très bien avec SQLite + Prisma)
enum QuotaPeriode {
  SEMESTRE
  ANNEE
}

enum Semestre {
  S1
  S2
}

// ======================================================================
// 1. Sécurité & Utilisateurs
// ======================================================================

model Role {
  id           Int          @id @default(autoincrement())
  libelle      String       @unique

  utilisateurs Utilisateur[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Statut {
  id            Int           @id @default(autoincrement())
  libelle       String        @unique
  quotaHeureMax Int
  quotaPeriode  QuotaPeriode

  utilisateurs  Utilisateur[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Utilisateur {
  id         String   @id @default(uuid())
  nom        String
  prenom     String
  email      String   @unique

  idRole     Int
  role       Role     @relation(fields: [idRole], references: [id], onDelete: Restrict)

  idStatut   Int
  statut     Statut   @relation(fields: [idStatut], references: [id], onDelete: Restrict)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?   // ← Soft delete

  enseignements Enseignement[]
}

// ======================================================================
// 2. Structure académique (grille ministérielle)
// ======================================================================

model Filiere {
  id       Int      @id @default(autoincrement())
  nom      String   @unique

  classes  Classe[]
  matieres Matiere[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Niveau {
  id      Int      @id @default(autoincrement())
  libelle String

  classes Classe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Classe {
  id         Int      @id @default(autoincrement())
  code       String   @unique

  filiereId  Int
  filiere    Filiere  @relation(fields: [filiereId], references: [id], onDelete: Restrict)

  niveauId   Int
  niveau     Niveau   @relation(fields: [niveauId], references: [id], onDelete: Restrict)

  courses    Course[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?   // ← Soft delete
}

// ======================================================================
// 3. Matières (grille ministérielle)
// ======================================================================

model Matiere {
  id        Int       @id @default(autoincrement())
  code      String
  nom       String
  credits   Int
  semestre  Semestre   // ← Enum pour forcer S1/S2

  filiereId Int
  filiere   Filiere   @relation(fields: [filiereId], references: [id], onDelete: Restrict)

  courses   Course[]

  @@unique([code, filiereId])   // Essentiel pour éviter doublons

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ======================================================================
// 4. Années académiques
// ======================================================================

model AnneeAcademique {
  id      Int      @id @default(autoincrement())
  libelle String   @unique   // ex: 2025-2026

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================================
// 5. Cœur métier : Instance de cours
// ======================================================================

model Course {
  id         String   @id @default(uuid())

  matiereId  Int
  matiere    Matiere  @relation(fields: [matiereId], references: [id], onDelete: Restrict)

  classeId   Int
  classe     Classe   @relation(fields: [classeId], references: [id], onDelete: Restrict)

  anneeId    Int
  annee      AnneeAcademique @relation(fields: [anneeId], references: [id], onDelete: Restrict)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?   // ← Soft delete

  enseignements Enseignement[]

  @@unique([matiereId, classeId, anneeId])   // Évite doublons de cours
}

// ======================================================================
// 6. Historique des affectations (traçabilité)
// ======================================================================

model Enseignement {
  id            String   @id @default(uuid())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  dateDebut     DateTime @default(now())
  dateFin       DateTime?
  motif         String?
  estActif      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId, estActif])     // Pour trouver rapidement l'enseignant actif
  @@index([utilisateurId])          // Pour calculer vite la charge horaire
}
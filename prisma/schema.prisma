generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================================
// ENUMS
// ======================================================================
enum QuotaPeriode {
  SEMESTRE
  ANNEE
}

enum Semestre {
  S1
  S2
  S3
  S4
  S5
  S6
}

enum StatutValidation {
  PROPOSITION
  VALIDE
  REJETE
}

// ======================================================================
// 1. Sécurité & Utilisateurs
// ======================================================================

model Role {
  id      Int    @id @default(autoincrement())
  libelle String @unique

  utilisateurs Utilisateur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Statut {
  id            Int          @id @default(autoincrement())
  libelle       String       @unique
  quotaHeureMax Int
  quotaPeriode  QuotaPeriode

  utilisateurs Utilisateur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Utilisateur {
  id       String @id @default(uuid())
  nom      String
  prenom   String
  email    String @unique
  mdp      String
  idRole   Int
  role     Role   @relation(fields: [idRole], references: [id])
  idStatut Int
  statut   Statut @relation(fields: [idStatut], references: [id])

  instituts    Institut[] 
  departements Departement[] // Les départements dirigés par ce chef

  attributions Attribution[] // NOUVEAU : Remplace enseignements

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ======================================================================
// 2. Structure académique
// ======================================================================

model Institut {
  id      Int     @id @default(autoincrement())
  nom     String  @unique
  adresse String?

  utilisateurs Utilisateur[]
  departements Departement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Departement {
  id         Int    @id @default(autoincrement())
  nom        String @unique

  institutId Int
  institut   Institut @relation(fields: [institutId], references: [id], onDelete: Restrict)

  utilisateurs Utilisateur[] // Les Chefs de département
  classes      Classe[]
  matieres     Matiere[]     // NOUVEAU : Relation Many-to-Many implicite avec Matière

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Niveau {
  id      Int    @id @default(autoincrement())
  libelle String

  classes Classe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Classe {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  
  departementId Int         
  departement   Departement @relation(fields: [departementId], references: [id], onDelete: Restrict)
  
  niveauId      Int
  niveau        Niveau      @relation(fields: [niveauId], references: [id], onDelete: Restrict)
  
  attributions  Attribution[] // NOUVEAU
  
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}


model Matiere {
  id           Int           @id @default(autoincrement())
  code         String        @unique // Le code est désormais unique globalement (ex: ENG101)
  nom          String
  credits      Int
  semestre     Semestre
  
  departements Departement[] // NOUVEAU : Une matière peut appartenir à plusieurs départements
  
  attributions Attribution[] // NOUVEAU
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================================
// 4. Années académiques
// ======================================================================

model AnneeAcademique {
  id      Int      @id @default(autoincrement())
  libelle String   @unique
  
  attributions Attribution[] // NOUVEAU
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================================
// 5. Cœur métier : L'Attribution (Directives M. Sonna)
// ======================================================================

model Attribution {
  id               String           @id @default(uuid())
  
  utilisateurId    String
  utilisateur      Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  
  matiereId        Int
  matiere          Matiere          @relation(fields: [matiereId], references: [id], onDelete: Restrict)
  
  classeId         Int
  classe           Classe           @relation(fields: [classeId], references: [id], onDelete: Restrict)
  
  anneeId          Int
  annee            AnneeAcademique  @relation(fields: [anneeId], references: [id], onDelete: Restrict)

  // Historique et réattributions
  dateDebut        DateTime         @default(now())
  dateFin          DateTime?
  motif            String?
  estActif         Boolean          @default(true) 
  statutValidation StatutValidation @default(PROPOSITION)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([matiereId, classeId, anneeId, estActif])
  @@index([utilisateurId])
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums
enum QuotaPeriode {
  SEMESTRE
  ANNEE
}

enum Semestre {
  S1
  S2
  S3
  S4
  S5
  S6
}

// ======================================================================
// 1. Sécurité & Utilisateurs
// ======================================================================

model Role {
  id      Int    @id @default(autoincrement())
  libelle String @unique

  utilisateurs Utilisateur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Statut {
  id            Int          @id @default(autoincrement())
  libelle       String       @unique
  quotaHeureMax Int
  quotaPeriode  QuotaPeriode

  utilisateurs Utilisateur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Utilisateur {
  id       String @id @default(uuid())
  nom      String
  prenom   String
  email    String @unique
  mdp      String
  idRole   Int
  role     Role   @relation(fields: [idRole], references: [id])
  idStatut Int
  statut   Statut @relation(fields: [idStatut], references: [id])

  instituts     Institut[] // Relation Many-to-Many
  deletedAt     DateTime?      @map("deleted_at")
  enseignements Enseignement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================================
// 2. Structure académique
// ======================================================================

model Institut {
  id           Int           @id @default(autoincrement())
  nom          String        @unique
  adresse      String?
  utilisateurs Utilisateur[]
  filieres     Filiere[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Filiere {
  id        Int        @id @default(autoincrement())
  nom       String     @unique
  instituts Institut[]
  classes   Classe[]
  matieres  Matiere[] // Relation inverse manquante ajoutée
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Niveau {
  id        Int      @id @default(autoincrement())
  libelle   String
  classes   Classe[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Classe {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  filiereId Int
  filiere   Filiere   @relation(fields: [filiereId], references: [id], onDelete: Restrict)
  niveauId  Int
  niveau    Niveau    @relation(fields: [niveauId], references: [id], onDelete: Restrict)
  courses   Course[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ======================================================================
// 3. Matières
// ======================================================================

model Matiere {
  id        Int      @id @default(autoincrement())
  code      String
  nom       String
  credits   Int
  semestre  Semestre
  filiereId Int
  filiere   Filiere  @relation(fields: [filiereId], references: [id], onDelete: Restrict)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, filiereId])
}

// ======================================================================
// 4. Années académiques
// ======================================================================

model AnneeAcademique {
  id        Int      @id @default(autoincrement())
  libelle   String   @unique
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================================
// 5. Cœur métier
// ======================================================================

model Course {
  id        String          @id @default(uuid())
  matiereId Int
  matiere   Matiere         @relation(fields: [matiereId], references: [id], onDelete: Restrict)
  classeId  Int
  classe    Classe          @relation(fields: [classeId], references: [id], onDelete: Restrict)
  anneeId   Int
  annee     AnneeAcademique @relation(fields: [anneeId], references: [id], onDelete: Restrict)

  enseignements Enseignement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([matiereId, classeId, anneeId])
}

enum StatutValidation {
  PROPOSITION
  VALIDE
  REJETE
}

model Enseignement {
  id            String      @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  dateDebut     DateTime    @default(now())
  dateFin       DateTime?
  motif         String?
  estActif      Boolean     @default(true)

  // NOUVEAU : Gère le workflow de M. Nsona
  statutValidation StatutValidation @default(PROPOSITION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, estActif])
  @@index([utilisateurId])
}
